#!/usr/bin/env bash
# Fake proot-distro for tests/e2e-docker.sh: every "distro" is a docker container (host network).
#   install ALIAS                 -> docker run -d rb-e2e-ALIAS
#   login ALIAS [--user U] -- CMD -> docker exec -i [-u U] rb-e2e-ALIAS CMD
set -u
img() {
  case $1 in
    archlinux) echo archlinux:latest ;; debian) echo debian:stable ;; ubuntu) echo ubuntu:24.04 ;;
    alpine) echo alpine:latest ;; fedora) echo fedora:latest ;; kali) echo kalilinux/kali-rolling ;;
    gentoo) echo gentoo/stage3 ;; *) return 1 ;;
  esac
}
cmd=$1; alias=$2; shift 2
case $cmd in
  install)
    docker rm -f "rb-e2e-$alias" >/dev/null 2>&1
    proxy=(); ca=()
    # Sandboxed CI/agents: forward an HTTPS-only egress proxy and its CA into the container.
    if [[ -n ${HTTPS_PROXY:-} ]]; then
      proxy=(-e "https_proxy=$HTTPS_PROXY" -e "HTTPS_PROXY=$HTTPS_PROXY" -e "no_proxy=localhost,127.0.0.1")
    fi
    if [[ -n ${RB_E2E_CA:-} ]]; then
      ca=(-v "$RB_E2E_CA:/rbca.crt:ro" -e SSL_CERT_FILE=/rbca.crt -e CURL_CA_BUNDLE=/rbca.crt)
    fi
    docker run -d --network host "${proxy[@]}" "${ca[@]}" --name "rb-e2e-$alias" "$(img "$alias")" \
      sleep infinity >/dev/null || exit
    [[ -n ${RB_E2E_CA:-} ]] || exit 0
    # Only HTTPS goes through such a proxy: move apt to https and trust the proxy CA everywhere.
    exec docker exec "rb-e2e-$alias" sh -c '
      for f in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt; do
        [ -f "$f" ] && cat /rbca.crt >>"$f"
      done
      if [ -d /etc/apt ]; then
        sed -i "s#http://#https://#g" /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null
        echo "Acquire::https::CAInfo \"/rbca.crt\";" >/etc/apt/apt.conf.d/99rb-e2e-ca
      fi
      true' ;;
  login)
    opts=()
    while [[ $1 != -- ]]; do
      [[ $1 == --user ]] && { opts+=(-u "$2"); shift; }
      shift
    done
    shift
    exec docker exec -i "${opts[@]}" "rb-e2e-$alias" "$@" ;;
esac
echo "fake proot-distro: unsupported $cmd" >&2; exit 1
